{
  "name": "cf-email-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Transactional email sending service on Cloudflare Email Service for ashesborn.cloud",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "dry": "wrangler deploy --dry-run --outdir dist",
    "send:rest": "node scripts/send-rest.mjs",
    "send:smtp": "node scripts/send-smtp.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "nodemailer": "^6.9.16",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
